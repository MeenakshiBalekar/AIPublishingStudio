# Copy to .env and fill in.

# Local SQLite database (Prisma)
DATABASE_URL="file:./dev.db"

# Anthropic Claude — powers the AI generation services.
# The app runs without this key (generation falls back to a deterministic stub),
# so you can develop the whole workflow before wiring real generation.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# Where uploaded source assets are stored (local StorageProvider in v1).
STORAGE_DIR="./storage"
